{"commands": [
 {"command": "parameters.add", "params": {"name": "in_x", "expression": "64 mm", "comment": "interior width: sleeved card 62 + 2 mm play", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "in_y", "expression": "62 mm", "comment": "interior depth: 90 double-sleeved cards (~56) + divider + grab room", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "in_z", "expression": "90.5 mm", "comment": "interior height: card 89 + 1.5", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "wall", "expression": "2.8 mm", "comment": "side wall (7 lines of 0.4)"}},
 {"command": "parameters.add", "params": {"name": "base_t", "expression": "2 mm", "comment": "floor thickness"}},
 {"command": "parameters.add", "params": {"name": "roof_t", "expression": "2 mm", "comment": "lid top thickness"}},
 {"command": "parameters.add", "params": {"name": "r_out", "expression": "4 mm", "comment": "vertical edge radius, > wall"}},
 {"command": "parameters.add", "params": {"name": "split", "expression": "64 mm", "comment": "body/lid split height (cards stick out ~22 mm above the lip)"}},
 {"command": "parameters.add", "params": {"name": "lip_h", "expression": "5 mm", "comment": "body lip height"}},
 {"command": "parameters.add", "params": {"name": "skirt", "expression": "1.2 mm", "comment": "lid skirt thickness over the lip"}},
 {"command": "parameters.add", "params": {"name": "fit", "expression": "0.3 mm", "comment": "CALIBRATE: lid/lip sliding clearance, 0.2-0.4", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "lip_ch", "expression": "0.8 mm", "comment": "lip top outer chamfer (lid arc clearance)"}},
 {"command": "parameters.add", "params": {"name": "reveal", "expression": "0.4 mm", "comment": "chamfer on both edges of the split line"}},
 {"command": "parameters.add", "params": {"name": "bed_ch", "expression": "0.8 mm", "comment": "body bottom chamfer (elephant foot)"}},
 {"command": "parameters.add", "params": {"name": "top_ch", "expression": "1 mm", "comment": "lid top chamfer (prints on the bed)"}},
 {"command": "parameters.add", "params": {"name": "leadin", "expression": "0.3 mm", "comment": "lead-in chamfer inside the lid skirt"}},
 {"command": "parameters.add", "params": {"name": "W", "expression": "in_x + 2*wall", "comment": "outer width"}},
 {"command": "parameters.add", "params": {"name": "D", "expression": "in_y + 2*wall", "comment": "outer depth"}},
 {"command": "parameters.add", "params": {"name": "H", "expression": "base_t + in_z + roof_t", "comment": "outer height"}},

 {"command": "sketch.create", "params": {"plane": "XY", "name": "BodySk"}},
 {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [34.8, 33.8]}, "dimensions": {"width": "W", "height": "D"}}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "BodySk", "distance": "split", "operation": "new", "name": "BodyBlock", "body_name": "Body"}},
 {"command": "solid.fillet", "params": {"body": "Body", "edges": [[34.8, 33.8, 32], [-34.8, 33.8, 32], [34.8, -33.8, 32], [-34.8, -33.8, 32]], "radius": "r_out", "name": "BodyCorners"}},
 {"command": "solid.chamfer", "params": {"body": "Body", "edges": [[0, -33.8, 0]], "distance": "bed_ch", "name": "BedChamfer"}},
 {"command": "solid.chamfer", "params": {"body": "Body", "edges": [[0, -33.8, 64]], "distance": "reveal", "name": "BodyReveal"}},
 {"command": "sketch.create", "params": {"plane": "XY", "offset": "split - 1", "name": "LipSk"}},
 {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [33.3, 32.3]}, "dimensions": {"width": "W - 2*(skirt + fit)", "height": "D - 2*(skirt + fit)"}}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "LipSk", "distance": "lip_h + 1", "operation": "join", "targets": ["Body"], "name": "Lip"}},
 {"command": "solid.fillet", "params": {"body": "Body", "edges": [[33.3, 32.3, 66.5], [-33.3, 32.3, 66.5], [33.3, -32.3, 66.5], [-33.3, -32.3, 66.5]], "radius": "r_out - skirt - fit", "name": "LipCorners"}},
 {"command": "solid.chamfer", "params": {"body": "Body", "edges": [[0, -32.3, 69]], "distance": "lip_ch", "name": "LipChamfer"}},

 {"command": "sketch.create", "params": {"plane": "XY", "offset": "base_t", "name": "CavitySk"}},
 {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [32, 31]}, "dimensions": {"width": "in_x", "height": "in_y"}}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "CavitySk", "distance": "split + lip_h", "operation": "cut", "targets": ["Body"], "name": "Cavity"}},
 {"command": "solid.fillet", "params": {"body": "Body", "edges": [[32, 31, 35], [-32, 31, 35], [32, -31, 35], [-32, -31, 35]], "radius": "r_out - wall", "name": "CavityCorners"}},
 {"command": "solid.fillet", "params": {"body": "Body", "edges": [[0, -31, 2]], "radius": 1, "name": "CavityFloorFillet"}},

 {"command": "parameters.add", "params": {"name": "label_w", "expression": "44 mm", "comment": "label recess width"}},
 {"command": "parameters.add", "params": {"name": "label_h", "expression": "30 mm", "comment": "label recess height"}},
 {"command": "parameters.add", "params": {"name": "label_d", "expression": "0.6 mm", "comment": "label recess depth (sticker)"}},
 {"command": "parameters.add", "params": {"name": "label_z", "expression": "32 mm", "comment": "label recess centre height"}},
 {"command": "parameters.add", "params": {"name": "ridge_r", "expression": "0.8 mm", "comment": "snap ridge radius"}},
 {"command": "parameters.add", "params": {"name": "ridge_proud", "expression": "0.6 mm", "comment": "CALIBRATE: how far the snap ridge stands off the lip, 0.4-0.8 (click strength = ridge_proud - fit)", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "ridge_l", "expression": "24 mm", "comment": "snap ridge length"}},
 {"command": "parameters.add", "params": {"name": "ridge_dz", "expression": "2.2 mm", "comment": "snap ridge height above the split"}},
 {"command": "parameters.add", "params": {"name": "groove_r", "expression": "0.9 mm", "comment": "lid groove radius (ridge_r + 0.1)"}},
 {"command": "parameters.add", "params": {"name": "ridge_y", "expression": "-D/2 + skirt + fit - ridge_proud + ridge_r", "comment": "snap ridge axis Y"}},
 {"command": "parameters.add", "params": {"name": "scallop_r", "expression": "22 mm", "comment": "thumb scallop sphere radius"}},
 {"command": "parameters.add", "params": {"name": "scallop_d", "expression": "1.3 mm", "comment": "thumb scallop depth"}},
 {"command": "solid.box", "params": {"length": "label_w", "width": "label_d + 1", "height": "label_h", "center": [0, "-D/2 + (label_d - 1)/2", "label_z"], "operation": "cut", "targets": ["Body"], "name": "LabelRecess"}},
 {"command": "solid.fillet", "params": {"body": "Body", "edges": [[22, -33.5, 17], [-22, -33.5, 17], [22, -33.5, 47], [-22, -33.5, 47]], "radius": 3, "name": "LabelCorners"}},
 {"command": "solid.cylinder", "params": {"radius": "ridge_r", "height": "ridge_l", "axis": "X", "base": ["-ridge_l/2", "ridge_y", "split + ridge_dz"], "operation": "join", "targets": ["Body"], "name": "SnapRidge"}},
 {"command": "solid.sphere", "params": {"radius": "scallop_r", "center": [0, "-D/2 - scallop_r + scallop_d", "split"], "operation": "cut", "targets": ["Body"], "name": "ThumbScallop"}},

 {"command": "parameters.add", "params": {"name": "hr", "expression": "3 mm", "comment": "hinge knuckle radius"}},
 {"command": "parameters.add", "params": {"name": "hclr", "expression": "0.35 mm", "comment": "CALIBRATE: radial clearance around the other part's knuckles, 0.3-0.5"}},
 {"command": "parameters.add", "params": {"name": "hgap", "expression": "0.4 mm", "comment": "CALIBRATE: axial gap between knuckles, 0.3-0.5"}},
 {"command": "parameters.add", "params": {"name": "hoff", "expression": "0.4 mm", "comment": "hinge axis behind the back face"}},
 {"command": "parameters.add", "params": {"name": "hole_body", "expression": "1.9 mm", "comment": "CALIBRATE: pin hole in body knuckles, snug on 1.75 filament (1.8-2.0)", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "hole_lid", "expression": "2.2 mm", "comment": "CALIBRATE: pin hole in lid knuckles, turns freely (2.1-2.4)", "favorite": true}},
 {"command": "parameters.add", "params": {"name": "span", "expression": "W - 2*r_out - 2", "comment": "hinge length = pin length (cut 1.75 filament to this)"}},
 {"command": "parameters.add", "params": {"name": "kx0", "expression": "-span/2", "comment": "hinge start X"}},
 {"command": "parameters.add", "params": {"name": "seg", "expression": "(span - 4*hgap)/5", "comment": "length of each of the 5 knuckles"}},
 {"command": "parameters.add", "params": {"name": "ya", "expression": "D/2 + hoff", "comment": "hinge axis Y (axis Z = split)"}},
 {"command": "solid.cylinder", "params": {"radius": "hr", "height": "seg", "axis": "X", "base": ["kx0", "ya", "split"], "operation": "join", "targets": ["Body"], "name": "BodyKnuckle"}},
 {"command": "sketch.create", "params": {"plane": "YZ", "offset": "kx0", "name": "BodyGussetSk"}},
 {"command": "sketch.line", "params": {"points": [["D/2 - 1", "split"], ["ya", "split"], ["ya + hr*sqrt(0.5)", "split - hr*sqrt(0.5)"], ["D/2 - 1", "split - 2*hr*sqrt(0.5) - hoff - 1"]], "closed": true}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "BodyGussetSk", "distance": "seg", "operation": "join", "targets": ["Body"], "name": "BodyGusset"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["BodyKnuckle", "BodyGusset"], "dir1": [1, 0, 0], "count1": 3, "spacing1": "2*(seg + hgap)", "name": "BodyKnuckles"}},
 {"command": "solid.cylinder", "params": {"radius": "hr + hclr", "height": "seg + 2*hgap", "axis": "X", "base": ["kx0 + seg", "ya", "split"], "operation": "cut", "targets": ["Body"], "name": "BodyNotch"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["BodyNotch"], "dir1": [1, 0, 0], "count1": 2, "spacing1": "2*(seg + hgap)", "name": "BodyNotches"}},
 {"command": "solid.cylinder", "params": {"diameter": "hole_body", "height": "span", "axis": "X", "base": ["kx0", "ya", "split"], "operation": "cut", "targets": ["Body"], "name": "BodyPinHole"}},
 {"command": "sketch.create", "params": {"plane": "YZ", "offset": "kx0", "name": "BodyTearSk"}},
 {"command": "sketch.line", "params": {"points": [["ya - hole_body/2*sqrt(0.5)", "split + hole_body/2*sqrt(0.5)"], ["ya + hole_body/2*sqrt(0.5)", "split + hole_body/2*sqrt(0.5)"], ["ya", "split + hole_body/2*sqrt(2)"]], "closed": true}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "BodyTearSk", "distance": "span", "operation": "cut", "targets": ["Body"], "name": "BodyPinTear"}},

 {"command": "sketch.create", "params": {"plane": "XY", "offset": "split", "name": "LidSk"}},
 {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [34.8, 33.8]}, "dimensions": {"width": "W", "height": "D"}}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "LidSk", "distance": "H - split", "operation": "new", "name": "LidBlock", "body_name": "Lid"}},
 {"command": "solid.fillet", "params": {"body": "Lid", "edges": [[34.8, 33.8, 80], [-34.8, 33.8, 80], [34.8, -33.8, 80], [-34.8, -33.8, 80]], "radius": "r_out", "name": "LidCorners"}},
 {"command": "solid.chamfer", "params": {"body": "Lid", "edges": [[0, -33.8, 64]], "distance": "reveal", "name": "LidReveal"}},
 {"command": "solid.chamfer", "params": {"body": "Lid", "edges": [[0, -33.8, 94.5]], "distance": "top_ch", "name": "LidTopChamfer"}},
 {"command": "sketch.create", "params": {"plane": "XY", "offset": "split - 1", "name": "LidCavitySk"}},
 {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [32, 31]}, "dimensions": {"width": "in_x", "height": "in_y"}}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "LidCavitySk", "distance": "H - roof_t - split + 1", "operation": "cut", "targets": ["Lid"], "name": "LidCavity"}},
 {"command": "solid.fillet", "params": {"body": "Lid", "edges": [[32, 31, 85], [-32, 31, 85], [32, -31, 85], [-32, -31, 85]], "radius": "r_out - wall", "name": "LidCavityCorners"}},
 {"command": "solid.fillet", "params": {"body": "Lid", "edges": [[0, -31, 92.5]], "radius": 1, "name": "LidCeilingFillet"}},
 {"command": "sketch.create", "params": {"plane": "XY", "offset": "split - 1", "name": "RebateSk"}},
 {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [33.6, 32.6]}, "dimensions": {"width": "W - 2*skirt", "height": "D - 2*skirt"}}},
 {"command": "sketch.fillet", "params": {"points": [{"a": "l1", "b": "l4"}, {"a": "l1", "b": "l2"}, {"a": "l2", "b": "l3"}, {"a": "l3", "b": "l4"}], "radius": "r_out - skirt"}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "RebateSk", "distance": "1 + lip_h + fit", "operation": "cut", "targets": ["Lid"], "name": "Rebate"}},
 {"command": "solid.chamfer", "params": {"body": "Lid", "edges": [[0, -32.6, 64]], "distance": "leadin", "name": "LeadIn"}},
 {"command": "solid.cylinder", "params": {"radius": "groove_r", "height": "ridge_l + 1", "axis": "X", "base": ["-(ridge_l + 1)/2", "ridge_y", "split + ridge_dz"], "operation": "cut", "targets": ["Lid"], "name": "SnapGroove"}},

 {"command": "solid.cylinder", "params": {"radius": "hr", "height": "seg", "axis": "X", "base": ["kx0 + seg + hgap", "ya", "split"], "operation": "join", "targets": ["Lid"], "name": "LidKnuckle"}},
 {"command": "sketch.create", "params": {"plane": "YZ", "offset": "kx0 + seg + hgap", "name": "LidGussetSk"}},
 {"command": "sketch.line", "params": {"points": [["D/2 - 1", "split"], ["ya", "split"], ["ya + hr*sqrt(0.5)", "split + hr*sqrt(0.5)"], ["D/2 - 1", "split + 2*hr*sqrt(0.5) + hoff + 1"]], "closed": true}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "LidGussetSk", "distance": "seg", "operation": "join", "targets": ["Lid"], "name": "LidGusset"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["LidKnuckle", "LidGusset"], "dir1": [1, 0, 0], "count1": 2, "spacing1": "2*(seg + hgap)", "name": "LidKnuckles"}},
 {"command": "solid.cylinder", "params": {"radius": "hr + hclr", "height": "seg + 2*hgap", "axis": "X", "base": ["kx0 - hgap", "ya", "split"], "operation": "cut", "targets": ["Lid"], "name": "LidNotch"}},
 {"command": "solid.pattern.rectangular", "params": {"features": ["LidNotch"], "dir1": [1, 0, 0], "count1": 3, "spacing1": "2*(seg + hgap)", "name": "LidNotches"}},
 {"command": "solid.cylinder", "params": {"diameter": "hole_lid", "height": "span", "axis": "X", "base": ["kx0", "ya", "split"], "operation": "cut", "targets": ["Lid"], "name": "LidPinHole"}},
 {"command": "sketch.create", "params": {"plane": "YZ", "offset": "kx0", "name": "LidTearSk"}},
 {"command": "sketch.line", "params": {"points": [["ya - hole_lid/2*sqrt(0.5)", "split - hole_lid/2*sqrt(0.5)"], ["ya + hole_lid/2*sqrt(0.5)", "split - hole_lid/2*sqrt(0.5)"], ["ya", "split - hole_lid/2*sqrt(2)"]], "closed": true}},
 {"command": "sketch.finish", "params": {}},
 {"command": "solid.extrude", "params": {"sketch": "LidTearSk", "distance": "span", "operation": "cut", "targets": ["Lid"], "name": "LidPinTear"}},

 {"command": "parameters.add", "params": {"name": "div_t", "expression": "1.6 mm", "comment": "divider thickness"}},
 {"command": "parameters.add", "params": {"name": "div_gap", "expression": "0.4 mm", "comment": "divider side clearance"}},
 {"command": "parameters.add", "params": {"name": "div_h", "expression": "84 mm", "comment": "divider height (below the cards)"}},
 {"command": "parameters.add", "params": {"name": "tab_w", "expression": "22 mm", "comment": "divider tab width"}},
 {"command": "parameters.add", "params": {"name": "tab_top", "expression": "89.5 mm", "comment": "divider tab top, < in_z"}},
 {"command": "solid.box", "params": {"length": "in_x - 2*div_gap", "width": "div_h", "height": "div_t", "corner": ["W/2 + 15", "-D/2", 0], "operation": "new", "name": "DividerPlate", "body_name": "Divider"}},
 {"command": "solid.box", "params": {"length": "tab_w", "width": "tab_top - div_h + 1", "height": "div_t", "corner": ["W/2 + 21", "-D/2 + div_h - 1", 0], "operation": "join", "targets": ["Divider"], "name": "DividerTab"}},
 {"command": "solid.fillet", "params": {"body": "Divider", "edges": [[49.8, -33.8, 0.8], [113, -33.8, 0.8], [113, 50.2, 0.8], [49.8, 50.2, 0.8], [55.8, 50.2, 0.8], [77.8, 50.2, 0.8], [55.8, 55.7, 0.8], [77.8, 55.7, 0.8]], "radius": 1.5, "name": "DividerCorners"}}
]}
